@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* ---------------------------------------------------------------- */
/* Arabic / RTL support                                              */
/* ---------------------------------------------------------------- */

[dir="rtl"] body {
  font-family: var(--font-mono-ar), var(--font-mono), sans-serif;
}

[dir="rtl"] .cz-display {
  font-family: var(--font-display-ar), var(--font-display), sans-serif;
}

/* Wide letter-spacing looks broken on Arabic script (it interrupts letter
   joining), so neutralise Tailwind's tracking utilities when RTL is active. */
[dir="rtl"] .tracking-widest,
[dir="rtl"] .tracking-wide {
  letter-spacing: normal;
}

/* cz-nav-link underline should grow from the same edge text reads from */
[dir="rtl"] .cz-nav-link::after {
  transform-origin: right;
}
